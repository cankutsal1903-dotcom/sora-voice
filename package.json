{
  "name": "sora-voice",
  "version": "1.0.2",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "npx expo run:android --variant debug",
    "live:build": "npx eas build --platform android --profile release-apk",
    "live:build:wait": "npx eas build --platform android --profile release-apk --wait",
    "store:build": "npx eas build --platform android --profile production",
    "live:server": "powershell -ExecutionPolicy Bypass -File scripts/start-live-server.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "node --check App.js",
    "voice:server": "npm --prefix server run start"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@livekit/react-native": "^3.1.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "^150.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.11",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "livekit-client": "^2.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
