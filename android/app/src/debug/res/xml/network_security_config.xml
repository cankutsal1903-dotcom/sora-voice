<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG / DEBUG-OPTIMIZED YAPILANDIRMASI
  Metro dev sunucusuna ve yerel token sunucusuna her ağ adresinden bağlanabilmek için
  debug derlemelerinde cleartext serbesttir. Bu dosya yalnızca debug varyantlarında
  main/res/xml/network_security_config.xml dosyasını geçersiz kılar.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
