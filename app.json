{
  "expo": {
    "name": "Sora",
    "slug": "sora-voice",
    "version": "1.0.4",
    "description": "Canlı sesli odalar, topluluk sohbeti ve güvenli etkileşim için Sora.",
    "primaryColor": "#2F80ED",
    "icon": "./assets/images/sora-logo-blue.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sora",
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "media"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sora, profil, aile ve oda görseli seçebilmen için fotoğraf arşivine erişir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/sora-logo-blue.png",
          "color": "#2F80ED",
          "defaultChannel": "sora-default",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sora-logo-blue.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#060D18"
        }
      ]
    ],
    "android": {
      "package": "com.arescan.soravoice",
      "versionCode": 21,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_VIDEO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sora-logo-blue.png",
        "backgroundColor": "#060D18"
      },
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.arescan.soravoice",
      "buildNumber": "21",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sora, sesli odalarda konuşabilmen için mikrofonuna erişir.",
        "NSPhotoLibraryUsageDescription": "Sora, profil, aile ve oda görseli seçebilmen için fotoğraf arşivine erişir.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "eaa65edd-9980-4db9-950a-9ecb047f0ad7"
      }
    },
    "owner": "arescan"
  }
}
