# ---------------------------------------------------------------------------
# Yerel gelistirme icin ornek degerler.
# Bu dosya `git`e commit edilir; GERCEK sirlar buraya yazilmaz.
# Kopyalayin:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Token sunucusunun telefonun ulasabildigi adresi.
# Bilgisayarin LAN IP'sini yazin:  ipconfig
EXPO_PUBLIC_TOKEN_SERVER_URL=http://192.168.1.40:3001

# Supabase proje ayarlari (public/publishable degerler - gizli degildir).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Expo push bildirimleri icin (npx eas init tarafindan eklenir).
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Uygulama hatalari token sunucusunun /errors adresine gonderilir.
EXPO_PUBLIC_ERROR_REPORTING_ENABLED=true

# IBAN ile manuel kredi talebi. Bu bilgiler uygulamada kullaniciya gosterilir.
EXPO_PUBLIC_BANK_ACCOUNT_HOLDER=YOUR_ACCOUNT_HOLDER
EXPO_PUBLIC_BANK_NAME=YOUR_BANK_NAME
EXPO_PUBLIC_BANK_IBAN=TR000000000000000000000000

# NOT: Bu degerler EAS bulut derlemesinde `.env` dosyasindan OKUNMAZ
# (dosya .gitignore icindedir ve EAS'e yuklenmez).
# Bulut derlemesi icin ayni degerleri `eas.json` icindeki profil `env`
# bloklarina da ekleyin.
